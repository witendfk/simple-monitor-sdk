{
  "name": "@simple-monitor/vue",
  "version": "0.1.0",
  "description": "Vue platform adapter for Simple Monitor SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simple-monitor/types": "workspace:*",
    "@simple-monitor/core": "workspace:*",
    "@simple-monitor/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "keywords": [
    "monitor",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witendfk/simple-monitor-sdk.git"
  }
}
