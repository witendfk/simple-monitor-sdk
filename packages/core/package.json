{
  "name": "@simple-monitor/core",
  "version": "0.0.1",
  "description": "Core monitoring logic for Simple Monitor SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simple-monitor/types": "workspace:*",
    "@simple-monitor/shared": "workspace:*",
    "@simple-monitor/utils": "workspace:*",
    "@simple-monitor/protocol": "workspace:*"
  },
  "keywords": [
    "monitor",
    "core"
  ],
  "author": "",
  "license": "MIT"
}
