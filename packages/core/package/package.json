{
  "name": "@simple-monitor/core",
  "version": "0.1.0",
  "description": "Core monitoring logic for Simple Monitor SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@simple-monitor/shared": "0.1.0",
    "@simple-monitor/protocol": "0.1.0",
    "@simple-monitor/utils": "0.1.0",
    "@simple-monitor/types": "0.1.0"
  },
  "keywords": [
    "monitor",
    "core"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witendfk/simple-monitor-sdk.git"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  }
}