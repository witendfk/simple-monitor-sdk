{
  "name": "@simple-monitor/web",
  "version": "0.1.0",
  "description": "Web integration bundle for Simple Monitor SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simple-monitor/types": "workspace:*",
    "@simple-monitor/utils": "workspace:*",
    "@simple-monitor/browser": "workspace:*",
    "@simple-monitor/core": "workspace:*",
    "@simple-monitor/web-performance": "workspace:*"
  },
  "keywords": [
    "monitor",
    "web"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witendfk/simple-monitor-sdk.git"
  },
  "devDependencies": {
    "@simple-monitor/react": "workspace:*",
    "@simple-monitor/vue": "workspace:*"
  }
}
