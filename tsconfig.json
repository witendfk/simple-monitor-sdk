{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@simple-monitor/protocol": ["./packages/protocol/src"],
      "@simple-monitor/types": ["./packages/types/src"],
      "@simple-monitor/shared": ["./packages/shared/src"],
      "@simple-monitor/utils": ["./packages/utils/src"],
      "@simple-monitor/core": ["./packages/core/src"],
      "@simple-monitor/browser": ["./packages/browser/src"],
      "@simple-monitor/vue": ["./packages/vue/src"],
      "@simple-monitor/react": ["./packages/react/src"],
      "@simple-monitor/web": ["./packages/web/src"],
      "@simple-monitor/web-performance": ["./packages/web-performance/src"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "examples"]
}
