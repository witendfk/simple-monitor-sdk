{
  "name": "simple-monitor-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Lightweight cross-platform frontend monitoring SDK",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "build:types": "pnpm --filter @simple-monitor/types run build",
    "build:utils": "pnpm --filter @simple-monitor/utils run build",
    "build:shared": "pnpm --filter @simple-monitor/shared run build",
    "build:core": "pnpm --filter @simple-monitor/core run build",
    "build:platforms": "pnpm -r --filter './packages/{browser,react,vue,web-performance,web}' run build",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/oracle/**'",
    "test:watch": "vitest",
    "demo:server": "node examples/server/index.js",
    "demo": "vite --config examples/web/vanilla/vite.config.ts",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "lint:ci": "eslint . --ext .ts,.tsx --max-warnings 171",
    "test:conformance": "vitest run test/oracle/conformance.spec.ts",
    "demo:full": "pnpm --filter @simple-monitor/server dev & sleep 2 && pnpm demo",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "pack:all": "node scripts/pack-all.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.1",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.6",
    "web-vitals": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "monitor",
    "sdk",
    "frontend",
    "error-tracking",
    "performance-monitoring"
  ],
  "author": "",
  "license": "MIT"
}
