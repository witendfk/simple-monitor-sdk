{
  "name": "simple-monitor-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Lightweight cross-platform frontend monitoring SDK",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "build:types": "pnpm --filter @simple-monitor/types run build",
    "build:utils": "pnpm --filter @simple-monitor/utils run build",
    "build:shared": "pnpm --filter @simple-monitor/shared run build",
    "build:core": "pnpm --filter @simple-monitor/core run build",
    "build:platforms": "pnpm -r --filter './packages/{browser,react,vue,web-performance,web}' run build",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:server": "node examples/server/index.js",
    "demo": "vite --config examples/web/vanilla/vite.config.ts",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "monitor",
    "sdk",
    "frontend",
    "error-tracking",
    "performance-monitoring"
  ],
  "author": "",
  "license": "MIT"
}
