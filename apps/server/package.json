{
  "name": "@simple-monitor/server",
  "version": "0.0.1",
  "description": "Simple Monitor server: ingest, queue, storage, query API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clickhouse/client": "^1.8.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
