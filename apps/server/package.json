    "@simple-monitor/protocol": "workspace:*",
    "express": "^4.18.2",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
